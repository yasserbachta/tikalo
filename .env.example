# Copy to .env and fill in. Values below are placeholders, not real secrets.

# Database (Prisma + Supabase)
DATABASE_URL=
DIRECT_URL=

# NextAuth
AUTH_SECRET=
AUTH_URL=
SUPER_ADMIN_EMAIL=

# OpenAI (ticket extraction)
OPENAI_API_KEY=

# Bunny storage / stream
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_API_KEY=

# Large-upload relay (shared with the upload-ticket-pdf Supabase edge function —
# set the same value there via `supabase secrets set`). Random 32+ bytes.
UPLOAD_TOKEN_SECRET=
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Login rate limiting (OPTIONAL). When both are set, the login action throttles
# brute-force attempts via Upstash Redis. When unset (local/CI/pre-setup), rate
# limiting is a no-op and login still works. Set real values in the deployment
# platform (e.g. Vercel project env), not here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
