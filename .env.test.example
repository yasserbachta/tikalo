# Test environment — copy to `.env.test` for local runs:
#   cp .env.test.example .env.test
#
# These are LOCAL, NON-SECRET values that point at the disposable Docker
# Postgres from docker-compose.test.yml. NEVER point DATABASE_URL/DIRECT_URL at
# a remote or production database: the integration suite runs a destructive
# `prisma db push --force-reset` and a TRUNCATE-everything reset between tests.
# A guard rail in tests/db/global-setup.ts refuses to run unless the URL is on
# localhost, but don't rely on it — keep this file local.

# Disposable container (docker-compose.test.yml maps it to host port 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tikalo_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/tikalo_test"

AUTH_SECRET="test-secret-not-used"
AUTH_URL="http://localhost:3000"

NODE_ENV="test"

# Dummy values for every var some module reads at import time, so importing the
# app's modules under Vitest never throws. None of these are real.
SUPER_ADMIN_EMAIL="admin@tikalo.test"
OPENAI_API_KEY="test-openai-key"
BUNNY_STORAGE_ZONE_NAME="test-zone"
BUNNY_STORAGE_API_KEY="test-bunny-key"
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID="0"
BUNNY_STREAM_API_KEY="test-bunny-stream-key"
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME="test.b-cdn.net"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key"
RESEND_API_KEY="test-resend-key"
EMAIL_FROM="noreply@tikalo.test"

# Rate limiting no-ops when these are unset (login keeps working). Leave them
# commented out so the suite exercises the disabled-limiter path.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
